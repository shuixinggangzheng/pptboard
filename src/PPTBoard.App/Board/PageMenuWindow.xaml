<host:OverlayWindow x:Class="PPTBoard.App.Board.PageMenuWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:host="clr-namespace:PPTBoard.App.Host"
                    Width="320">
    <Border Background="{StaticResource GlassPanelBrush}" BorderBrush="{StaticResource GlassBorderBrush}"
            BorderThickness="1" CornerRadius="12">
        <Grid Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="52"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="16,0">
                <TextBlock Text="页面" Foreground="{StaticResource IconBrush}" FontSize="15" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <Button x:Name="NewPageButton" Content="＋ 新建页" Style="{StaticResource DockButtonStyle}"
                        Width="92" Height="32" HorizontalAlignment="Right" Click="OnNewPageClick"/>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <WrapPanel x:Name="ItemsPanel" Orientation="Horizontal" Margin="8,0"/>
            </ScrollViewer>

            <Button Grid.Row="2" Content="收起" Style="{StaticResource DockButtonStyle}" Width="92" Height="32"
                    HorizontalAlignment="Center" Click="OnCollapseClick"/>
        </Grid>
    </Border>
</host:OverlayWindow>
