<host:OverlayWindow x:Class="PPTBoard.App.Board.ClearSliderWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:host="clr-namespace:PPTBoard.App.Host"
                    Width="400" Height="44">
    <Border Background="{StaticResource GlassBrush}" BorderBrush="{StaticResource GlassBorderBrush}"
            BorderThickness="1" CornerRadius="22">
        <Grid>
            <TextBlock Text="向右滑动清空本页" Foreground="{StaticResource MutedIconBrush}" FontSize="12"
                       HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
            <Border x:Name="Thumb" Width="36" Height="36" CornerRadius="18" Background="#F2FFFFFF"
                    HorizontalAlignment="Left" Margin="4,0,0,0">
                <Path Data="M8,12 L14,18 L8,24 M14,18 H24" Stroke="#FF2F7CF6" StrokeThickness="2"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" Width="14" Height="14"/>
            </Border>
        </Grid>
    </Border>
</host:OverlayWindow>
