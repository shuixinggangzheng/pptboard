<host:OverlayWindow x:Class="PPTBoard.App.Board.BoardWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:host="clr-namespace:PPTBoard.App.Host"
                    xmlns:board="clr-namespace:PPTBoard.App.Board"
                    Background="White" Width="1664" Height="984">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="56"/>
        </Grid.RowDefinitions>

        <board:InkLayer x:Name="Ink" Grid.Row="0" IsHitTestVisible="False"/>

        <Border Grid.Row="1" Background="{StaticResource GrayBarBrush}">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="16,0" VerticalAlignment="Center">
                    <Button x:Name="UndoButton" Style="{StaticResource GrayBarButtonStyle}" Click="OnUndoClick" ToolTip="撤销">
                        <Path Style="{StaticResource GrayIconPathStyle}" Data="M9,7 L4,12 L9,17 M4,12 H13 A4,4 0 0 0 13,4"/>
                    </Button>
                    <Button x:Name="EraserButton" Style="{StaticResource GrayBarButtonStyle}" Margin="6,0,0,0" Click="OnEraserClick" ToolTip="橡皮擦">
                        <Path Style="{StaticResource GrayIconPathStyle}" Data="M6,15 L12,9 L16,13 L10,19 Z M12,9 L16,5"/>
                    </Button>
                </StackPanel>

                <Button x:Name="CollapseButton" Style="{StaticResource GrayBarButtonStyle}"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Click="OnCollapseClick" ToolTip="收起画板">
                    <Path Style="{StaticResource GrayIconPathStyle}" Data="M10,17 L10,5 M4,11 L10,5 L16,11"/>
                </Button>

                <Border HorizontalAlignment="Right" Width="111" Height="56" Background="#EBFFFFFF" CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="32"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource PageArrowStyle}" Click="OnPrevPageClick">
                            <Path Style="{StaticResource GrayIconPathStyle}" Data="M13,4 L7,10 L13,16"/>
                        </Button>
                        <Button Grid.Column="1" Style="{StaticResource PageBoxCenterStyle}" Click="OnPageBoxClick">
                            <TextBlock x:Name="PageText" Text="1/1" FontFamily="Microsoft YaHei UI"
                                       FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource GrayIconBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <Button Grid.Column="2" Style="{StaticResource PageArrowStyle}" Click="OnNextPageClick">
                            <Path Style="{StaticResource GrayIconPathStyle}" Data="M7,4 L13,10 L7,16"/>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</host:OverlayWindow>
