<host:OverlayWindow x:Class="PPTBoard.App.Dock.PenOptionsWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:host="clr-namespace:PPTBoard.App.Host"
                    Width="300" Height="48">
    <Border Background="{StaticResource GlassPanelBrush}" BorderBrush="{StaticResource GlassBorderBrush}"
            BorderThickness="1" CornerRadius="10">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button Content="笔" Width="64" Height="34" Style="{StaticResource DockButtonStyle}"
                    Foreground="{StaticResource IconBrush}" FontSize="13" Click="OnPenClick"/>
            <Button Content="橡皮" Width="64" Height="34" Margin="4,0,0,0" Style="{StaticResource DockButtonStyle}"
                    Foreground="{StaticResource IconBrush}" FontSize="13" Click="OnEraserClick"/>
            <Button Content="箭头" Width="64" Height="34" Margin="4,0,0,0" Style="{StaticResource DockButtonStyle}"
                    Foreground="{StaticResource IconBrush}" FontSize="13" Click="OnArrowClick"/>
            <Button Content="颜色" Width="64" Height="34" Margin="4,0,0,0" Style="{StaticResource DockButtonStyle}"
                    Foreground="{StaticResource IconBrush}" FontSize="13" Click="OnColorClick"/>
        </StackPanel>
    </Border>
</host:OverlayWindow>
