<host:OverlayWindow x:Class="PPTBoard.App.Dock.MainDockWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:host="clr-namespace:PPTBoard.App.Host"
                    Width="332" Height="40">
    <Border Background="{StaticResource GlassBrush}"
            BorderBrush="{StaticResource GlassBorderBrush}"
            BorderThickness="1"
            CornerRadius="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.28" Color="#000000"/>
        </Border.Effect>
        <StackPanel Orientation="Horizontal" Margin="13,0" VerticalAlignment="Center">
            <Button x:Name="ColorButton" Style="{StaticResource DockButtonStyle}" Click="OnColorClick" ToolTip="画笔颜色">
                <Ellipse x:Name="ColorDot" Width="20" Height="20" Fill="Black" Stroke="#66FFFFFF" StrokeThickness="1.5"/>
            </Button>
            <Button x:Name="PrevButton" Style="{StaticResource DockButtonStyle}" Margin="4,0,0,0" Click="OnPrevClick" ToolTip="上一页">
                <Path Style="{StaticResource IconPathStyle}" Data="M12,4 L5,10 L12,16"/>
            </Button>
            <Button x:Name="NextButton" Style="{StaticResource DockButtonStyle}" Margin="4,0,0,0" Click="OnNextClick" ToolTip="下一页">
                <Path Style="{StaticResource IconPathStyle}" Data="M8,4 L15,10 L8,16"/>
            </Button>
            <Button x:Name="PenButton" Style="{StaticResource DockButtonStyle}" Margin="4,0,0,0" Click="OnPenClick" ToolTip="原生笔">
                <Path Style="{StaticResource IconPathStyle}" Data="M4,16 L4,12 L12,4 L16,8 L8,16 Z"/>
            </Button>
            <Button x:Name="EraserButton" Style="{StaticResource DockButtonStyle}" Margin="4,0,0,0" Click="OnEraserClick" ToolTip="橡皮擦（擦除手写笔迹，Ctrl+E）">
                <Path Style="{StaticResource IconPathStyle}" Data="M6,15 L12,9 L16,13 L10,19 Z M12,9 L16,5"/>
            </Button>
            <Button x:Name="BoardButton" Style="{StaticResource DockButtonStyle}" Margin="4,0,0,0" Click="OnBoardClick" ToolTip="画板">
                <Path Style="{StaticResource IconPathStyle}" Data="M4,5 H16 V14 H4 Z M8,18 L11,15 M16,18 L13,15"/>
            </Button>
            <Button x:Name="EndButton" Style="{StaticResource DockButtonStyle}" Margin="4,0,0,0" Click="OnEndClick" ToolTip="结束放映">
                <Path Width="18" Height="18" Stretch="Uniform" Fill="{StaticResource IconBrush}" Data="M6,6 H14 V14 H6 Z"/>
            </Button>
        </StackPanel>
    </Border>
</host:OverlayWindow>
